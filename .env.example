# Copy to .env (or .env.sandbox) for local work and put the same names in your host's settings.
# Real values never go in git: .env, .env.* and .dev.vars are git-ignored.

# --- Paddle (billing: webhooks, customer mirror, portal) ---
# "sandbox" for testing, "production" for the live account.
PADDLE_ENV=sandbox
# Server-side API key (pdl_sdbx_apikey_... / pdl_live_apikey_...). Secret. NOT used to verify webhooks.
PADDLE_API_KEY=
# Notification destination SIGNING SECRET (pdlntfset_...). Secret. Used only to verify webhook signatures.
# Created with the destination (Developer tools > Notifications) and shown once there / via the API.
PADDLE_WEBHOOK_SECRET=
# Public client-side token for Paddle.js (test_... / live_...). Safe to expose; only for the browser checkout.
PADDLE_CLIENT_TOKEN=

# --- Dodo Payments (the Pro unlock flow currently on the live site) ---
DODO_ENV=test
DODO_API_KEY=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=
DODO_PRODUCT_BOOST=
